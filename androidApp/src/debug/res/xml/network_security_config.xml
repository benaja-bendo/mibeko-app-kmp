<?xml version="1.0" encoding="utf-8"?>
<!-- Variante DEBUG : autorise le HTTP en clair vers les serveurs de
     développement locaux uniquement. La variante release (androidMain)
     interdit tout trafic en clair. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">192.168.0.78</domain>
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
    </domain-config>
</network-security-config>
