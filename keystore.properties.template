# Fichier de propriétés pour le keystore de production.
# Les secrets de signature vivent HORS du dépôt : placez le fichier rempli
# dans ../../secrets/mibeko-app-kmp/keystore.properties (emplacement par défaut,
# relatif à la racine du projet), ou surchargez le chemin via
# -PkeystorePropertiesFile=/chemin/keystore.properties ou la variable
# d'environnement MIBEKO_KEYSTORE_PROPERTIES.
# `storeFile` est résolu relativement à l'emplacement de ce fichier.

storeFile=./mibeko.jks
storePassword=votre_mot_de_passe_store
keyAlias=votre_alias
keyPassword=votre_mot_de_passe_cle
