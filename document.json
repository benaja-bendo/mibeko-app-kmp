                            "string",
                            "null"
                          ]
                        },
                        "last": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "prev": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "next": {
                          "type": [
                            "string",
                            "null"
                          ]
                        }
                      },
                      "required": [
                        "first",
                        "last",
                        "prev",
                        "next"
                      ]
                    },
                    "meta": {
                      "type": "object",
                      "properties": {
                        "current_page": {
                          "type": "integer",
                          "minimum": 1
                        },
                        "from": {
                          "type": [
                            "integer",
                            "null"
                          ],
                          "minimum": 1
                        },
                        "last_page": {
                          "type": "integer",
                          "minimum": 1
                        },
                        "links": {
                          "type": "array",
                          "description": "Generated paginator links.",
                          "items": {
                            "type": "object",
                            "properties": {
                              "url": {
                                "type": [
                                  "string",
                                  "null"
                                ]
                              },
                              "label": {
                                "type": "string"
                              },
                              "active": {
                                "type": "boolean"
                              }
                            },
                            "required": [
                              "url",
                              "label",
                              "active"
                            ]
                          }
                        },
                        "path": {
                          "type": [
                            "string",
                            "null"
                          ],
                          "description": "Base path for paginator generated URLs."
                        },
                        "per_page": {
                          "type": "integer",
                          "description": "Number of items shown per page.",
                          "minimum": 0
                        },
                        "to": {
                          "type": [
                            "integer",
                            "null"
                          ],
                          "description": "Number of the last item in the slice.",
                          "minimum": 1
                        },
                        "total": {
                          "type": "integer",
                          "description": "Total number of items being paginated.",
                          "minimum": 0
                        }
                      },
                      "required": [
                        "current_page",
                        "from",
                        "last_page",
                        "links",
                        "path",
                        "per_page",
                        "to",
                        "total"
                      ]
                    }
                  },
                  "required": [
                    "data",
                    "links",
                    "meta"
                  ]
                }
              }
            }
          },
          "422": {
            "$ref": "#/components/responses/ValidationException"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ArticleResource": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "number": {
            "type": "string"
          },
          "order": {
            "type": "integer"
          },
          "content": {
            "type": "string"
          },
          "validation_status": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "number",
          "order",
          "validation_status"
        ],
        "title": "ArticleResource"
      },
      "ArticleSyncResource": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "document_id": {
            "type": "string"
          },
          "parent_node_id": {
            "type": "string"
          },
          "number": {
            "type": "string"
          },
          "order": {
            "type": "string"
          },
          "content": {
            "type": "string"
          },
          "updated_at": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "document_id",
          "parent_node_id",
          "number",
          "order",
          "updated_at"
        ],
        "title": "ArticleSyncResource"
      },
      "DocumentRelationResource": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "source_document_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "target_document_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "relation_type": {
            "type": "string"
          },
          "comment": {
            "type": [
              "string",
              "null"
            ]
          },
          "target_document": {
            "$ref": "#/components/schemas/LegalDocumentResource"
          }
        },
        "required": [
          "id",
          "source_document_id",
          "target_document_id",
          "relation_type",
          "comment"
        ],
        "title": "DocumentRelationResource"
      },
      "DocumentTypeResource": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "hierarchy_level": {
            "type": "integer"
          }
        },
        "required": [
          "code",
          "name",
          "hierarchy_level"
        ],
        "title": "DocumentTypeResource"
      },
      "InstitutionResource": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "acronym": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "acronym"
        ],
        "title": "InstitutionResource"
      },
      "LegalDocumentResource": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "reference": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "type": "string"
          },
          "dates": {
            "type": "object",
            "properties": {
              "signature": {
                "type": "string"
              },
              "publication": {
                "type": "string"
              }
            },
            "required": [
              "signature",
              "publication"
            ]
          },
          "institution": {
            "$ref": "#/components/schemas/InstitutionResource"
          },
          "type": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "name": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "name"
            ]
          },
          "structure": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/StructureNodeResource"
            }
          },
          "articles": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ArticleSyncResource"
            }
          },
          "relations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DocumentRelationResource"
            }
          },
          "updated_at": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "reference",
          "status",
          "dates",
          "updated_at"
        ],
        "title": "LegalDocumentResource"
      },
      "StructureNodeResource": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "number": {
            "type": [
              "string",
              "null"
            ]
          },
          "title": {
            "type": [
              "string",
              "null"
            ]
          },
          "order": {
            "type": "integer"
          },
          "articles": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ArticleResource"
            }
          }
        },
        "required": [
          "id",
          "type",
          "number",
          "title",
          "order"
        ],
        "title": "StructureNodeResource"
      },
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "email_verified_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "created_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "updated_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "two_factor_confirmed_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "name",
          "email",
          "email_verified_at",
          "created_at",
          "updated_at",
          "two_factor_confirmed_at"
        ],
        "title": "User"
      }
    },
    "responses": {
      "ValidationException": {
        "description": "Validation error",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "message": {
                  "type": "string",
                  "description": "Errors overview."
                },
                "errors": {
                  "type": "object",
                  "description": "A detailed description of each field that failed validation.",
                  "additionalProperties": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              },
              "required": [
                "message",
                "errors"
              ]
            }
          }
        }
      },
      "AuthenticationException": {
        "description": "Unauthenticated",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "message": {
                  "type": "string",
                  "description": "Error overview."
                }
              },
              "required": [
                "message"
              ]
            }
          }
        }
      }
    }
