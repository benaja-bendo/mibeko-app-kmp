              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/ArticleSyncResource"
                      }
                    },
                    "links": {
                      "type": "object",
                      "properties": {
                        "first": {
