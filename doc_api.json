{
  "openapi": "3.1.0",
  "info": {
    "title": "Mibeko",
    "version": "0.0.1"
  },
  "servers": [
    {
      "url": "http://localhost:8000/api"
    }
  ],
  "paths": {
    "/v1/search": {
      "get": {
        "operationId": "v1.articleSearch.search_0",
        "description": "This endpoint performs a sophisticated hybrid search:\n1. **Full-Text Search**: Uses PostgreSQL `ts_rank` for precise keyword matching.\n2. **Semantic Search**: Uses `pgvector` and OpenAI embeddings to find conceptually related articles.\n3. **AI Answer**: If a query is provided, it uses the top results as context for a RAG (Retrieval-Augmented Generation) answer.",
        "summary": "Search articles (Hybrid: Vector + Full-Text) and provide AI answer (RAG)",
        "tags": [
          "ArticleSearch"
        ],
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 2
            }
          },
          {
            "name": "document_id",
            "in": "query",
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          {
            "name": "tag",
            "in": "query",
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          {
            "name": "type",
            "in": "query",
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "integer",
                  "enum": [
                    200
                  ]
                }
              }
            }
          },
          "422": {
            "$ref": "#/components/responses/ValidationException"
          }
        }
      }
    },
