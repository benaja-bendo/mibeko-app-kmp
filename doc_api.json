    "/v1/sync/updates": {
      "get": {
        "operationId": "sync.updates",
        "summary": "Get articles updated since a given timestamp",
        "tags": [
          "Sync"
        ],
        "parameters": [
          {
            "name": "since",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "updated": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/ArticleSyncResource"
                          }
                        },
                        "deleted_ids": {
                          "type": "array",
                          "items": {}
                        }
                      },
                      "required": [
                        "updated",
                        "deleted_ids"
                      ]
                    },
                    "meta": {
                      "type": "object",
                      "properties": {
                        "current_page": {
                          "type": "integer"
                        },
                        "last_page": {
                          "type": "integer"
                        },
                        "total": {
                          "type": "integer"
                        },
                        "server_time": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "current_page",
                        "last_page",
                        "total",
                        "server_time"
                      ]
                    }
                  },
                  "required": [
                    "data",
                    "meta"
                  ]
                }
              }
            }
          },
          "422": {
            "$ref": "#/components/responses/ValidationException"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ArticleBriefResource": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "number": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "string",
                "enum": [
                  ""
                ]
              }
            ]
          },
          "order": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer",
                "enum": [
                  0
                ]
              }
            ]
          },
          "content": {
            "type": "string"
          },
          "validation_status": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "string",
                "enum": [
                  "validated"
                ]
              }
            ]
          }
        },
        "required": [
          "id",
          "number",
          "order",
          "validation_status"
        ],
        "title": "ArticleBriefResource"
      },
      "ArticleSyncResource": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "document_id": {
            "type": "string"
          },
          "parent_node_id": {
            "type": "string"
