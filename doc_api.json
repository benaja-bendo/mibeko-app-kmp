    "/v1/catalog": {
      "get": {
        "operationId": "catalog.index",
        "description": "Returns the global sync state and the list of available resources.\nMobile app uses this to detect if it needs to update its local database.",
        "summary": "Get the global catalog status",
        "tags": [
          "Catalog"
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "message": {
                      "type": "string",
                      "enum": [
                        "Catalogue récupéré avec succès"
                      ]
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "global_update_required": {
                          "type": "boolean"
                        },
                        "last_essential_sync": {
                          "type": "string",
                          "description": "Dynamic logic to be added"
                        },
                        "resources": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/LegalDocumentCatalogResource"
                          }
                        }
                      },
                      "required": [
                        "global_update_required",
                        "last_essential_sync",
                        "resources"
                      ]
                    }
                  },
                  "required": [
                    "success",
                    "message",
                    "data"
                  ]
                }
              }
            }
          }
        }
      }
    },
