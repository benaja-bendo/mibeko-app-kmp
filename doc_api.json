    "/v1/sync/updates": {
      "get": {
        "operationId": "sync.updates",
        "summary": "Get articles updated since a given timestamp",
        "tags": [
          "Sync"
        ],
        "parameters": [
          {
            "name": "since",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "updated": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/ArticleSyncResource"
                          }
                        },
                        "deleted_ids": {
                          "type": "array",
                          "items": {}
                        }
                      },
                      "required": [
                        "updated",
                        "deleted_ids"
