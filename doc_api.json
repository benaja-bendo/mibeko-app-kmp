    },
    "/v1/legal-documents/{id}/pdf": {
      "get": {
        "operationId": "pdfProxy.show",
        "summary": "Proxy a PDF from the document's source URL (MinIO/S3).\nThis ensures the mobile app gets the file via the API without exposing direct S3 links",
        "tags": [
          "PdfProxy"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "download",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "headers": {
              "Transfer-Encoding": {
                "required": true,
                "schema": {
                  "type": "string",
                  "enum": [
                    "chunked"
                  ]
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/ModelNotFoundException"
          }
        }
      }
    },
    "/v1/legal-documents/{documentId}/tree": {
      "get": {
        "operationId": "structureNode.tree",
        "description": "Returns the structure tree for a specific document. This is useful for displaying \na table of contents or navigating through the document's divisions (Books, Titles, etc.).",
        "summary": "Get document hierarchy",
        "tags": [
          "StructureNode"
        ],
        "parameters": [
          {
            "name": "documentId",
            "in": "path",
            "required": true,
            "description": "The UUID of the legal document.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "message": {
                      "type": "string",
                      "enum": [
                        "Structure récupérée avec succès"
                      ]
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/StructureNodeResource"
