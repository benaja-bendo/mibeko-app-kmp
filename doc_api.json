            "type": "string"
          },
          "hierarchy_level": {
            "type": "integer"
          }
        },
        "required": [
          "code",
          "name",
          "hierarchy_level"
        ],
        "title": "DocumentTypeResource"
      },
      "InstitutionResource": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "acronym": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "acronym"
        ],
        "title": "InstitutionResource"
      },
      "LegalDocumentResource": {
        "type": "object",
