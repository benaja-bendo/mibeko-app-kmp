                    }
                  },
                  "required": [
                    "success",
                    "message",
                    "data"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/v1/legal-documents/{id}/download": {
      "get": {
        "operationId": "legalDocumentDownload.download",
        "description": "Returns a flat list of structure nodes and articles for offline sync. \nThis is optimized for the mobile application's local database insertion.",
        "summary": "Download legal document data (Flat List)",
        "tags": [
          "LegalDocumentDownload"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "The UUID of the legal document.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "node_id",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "integer",
                  "enum": [
                    200
                  ]
                }
              }
            }
          }
        }
      }
    },
