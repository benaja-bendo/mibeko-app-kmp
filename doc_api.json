    "/v1/search": {
      "get": {
        "operationId": "v1.articleSearch.search_0",
        "description": "Combines `ts_rank` (keyword search) and `cosine_distance` (semantic search).",
        "summary": "Search articles (Hybrid: Vector + Full-Text)",
        "tags": [
          "ArticleSearch"
        ],
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 2
            }
          },
          {
            "name": "document_id",
            "in": "query",
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "message": {
                      "type": "string",
                      "enum": [
                        "Résultats de recherche récupérés avec succès"
                      ]
                    },
                    "data": {
                      "type": "string"
                    },
                    "pagination": {
                      "type": "object",
                      "properties": {
                        "total": {
                          "type": "string"
                        },
                        "per_page": {
                          "type": "string"
                        },
                        "current_page": {
                          "type": "string"
                        },
                        "last_page": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "total",
                        "per_page",
                        "current_page",
                        "last_page"
                      ]
                    }
                  },
                  "required": [
                    "success",
                    "message",
                    "data",
                    "pagination"
                  ]
                }
              }
            }
          },
          "422": {
            "$ref": "#/components/responses/ValidationException"
          }
        }
      }
    },
