    "/v1/login": {
      "post": {
        "operationId": "auth.login",
        "description": "Returns a Sanctum plain-text token.",
        "summary": "Login",
        "tags": [
          "Auth"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
