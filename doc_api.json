    "/v1/legal-documents/{id}/download": {
      "get": {
        "operationId": "legalDocumentDownload.download",
        "description": "Returns a flat list of structure nodes and articles for offline sync.",
        "summary": "Download legal document data (Flat List)",
        "tags": [
          "LegalDocumentDownload"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "node_id",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "message": {
                      "type": "string",
                      "enum": [
                        "Téléchargement préparé avec succès"
                      ]
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "resource_id": {
                          "type": "string"
                        },
                        "node_id": {
                          "anyOf": [
                            {
                              "type": "string"
                            },
                            {
                              "type": "array",
                              "items": {}
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "generated_at": {
                          "type": "string"
                        },
                        "nodes": {
                          "type": "string"
                        },
                        "articles": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "resource_id",
                        "node_id",
                        "generated_at",
                        "nodes",
                        "articles"
                      ]
                    }
                  },
                  "required": [
                    "success",
                    "message",
                    "data"
                  ]
                }
              }
            }
          }
        }
      }
    },
