            }
          }
        }
      }
    },
    "/v1/home": {
      "get": {
        "operationId": "home.index",
        "description": "Returns a curated list of data for the mobile home screen:\n- **Popular Codes**: Priority legal documents.\n- **Recently Added**: Latest documents published.\n- **AI Suggestions**: Example questions to ask the AI search.",
        "summary": "Get home page data",
        "tags": [
          "Home"
