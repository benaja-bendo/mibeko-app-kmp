        "summary": "Search articles (Hybrid: Vector + Full-Text) and provide AI answer (RAG)",
        "tags": [
          "ArticleSearch"
        ],
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 2
            }
          },
          {
            "name": "document_id",
            "in": "query",
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          {
            "name": "tag",
            "in": "query",
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          {
            "name": "type",
            "in": "query",
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "integer",
                  "enum": [
                    200
                  ]
                }
              }
            }
          },
          "422": {
            "$ref": "#/components/responses/ValidationException"
          }
        }
      }
    },
    "/v1/login": {
      "post": {
        "operationId": "auth.login",
        "description": "Returns a Sanctum plain-text token.",
        "summary": "Login",
        "tags": [
          "Auth"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "password": {
                    "type": "string"
                  },
                  "device_name": {
                    "type": "string"
                  }
                },
                "required": [
                  "email",
                  "password",
                  "device_name"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "token": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "token"
                  ]
                }
              }
            }
          },
          "422": {
            "$ref": "#/components/responses/ValidationException"
          }
        }
      }
    },
    "/v1/me": {
      "get": {
        "operationId": "auth.me",
        "summary": "Get authenticated user",
        "tags": [
          "Auth"
        ],
        "responses": {
          "200": {
            "description": "`User`",
            "content": {
              "application/json": {
                "schema": {
