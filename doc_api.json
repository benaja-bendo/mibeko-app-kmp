    "/v1/legal-documents/{id}/pdf": {
      "get": {
        "operationId": "pdfProxy.show",
        "summary": "Proxy a PDF from the document's source URL (MinIO/S3).\nThis ensures the mobile app gets the file via the API without exposing direct S3 links",
        "tags": [
          "PdfProxy"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "download",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "headers": {
              "Transfer-Encoding": {
                "required": true,
                "schema": {
                  "type": "string",
                  "enum": [
                    "chunked"
                  ]
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/ModelNotFoundException"
          }
        }
      }
