    },
    "/v1/legal-documents/{id}": {
      "get": {
        "operationId": "legal-documents.show",
        "description": "Returns a single legal document with its articles, relations, and their latest versions.",
        "summary": "Get a legal document",
        "tags": [
          "LegalDocument"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "message": {
                      "type": "string",
                      "enum": [
                        "Document récupéré avec succès"
                      ]
