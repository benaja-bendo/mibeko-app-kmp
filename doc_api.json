    "/v1/legal-documents": {
      "get": {
        "operationId": "legal-documents.index",
        "description": "Returns a paginated list of legal documents with their institutions and types.\nSupports filtering and sorting via query parameters.",
        "summary": "List legal documents",
        "tags": [
          "LegalDocument"
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "message": {
                      "type": "string",
                      "enum": [
                        "Documents récupérés avec succès"
                      ]
                    },
                    "data": {
                      "type": "string"
                    },
                    "pagination": {
                      "type": "object",
                      "properties": {
                        "total": {
                          "type": "string"
                        },
                        "per_page": {
                          "type": "string"
                        },
                        "current_page": {
                          "type": "string"
                        },
                        "last_page": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "total",
                        "per_page",
                        "current_page",
                        "last_page"
                      ]
                    }
                  },
