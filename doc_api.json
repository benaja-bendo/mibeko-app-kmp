          "number": {
            "type": "string"
          },
          "order": {
            "type": "string"
          },
          "content": {
            "type": "string"
          },
          "tags": {
            "type": "string"
          },
          "updated_at": {
            "type": "string",
            "description": "or full tag objects if needed. PRD \"Semantic Tagging\" implies using string names for search."
          }
        },
        "required": [
          "id",
          "document_id",
          "parent_node_id",
          "number",
          "order",
          "updated_at"
        ],
        "title": "ArticleSyncResource"
      },
